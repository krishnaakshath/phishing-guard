# Copy to .env for local development. All of these are optional - the app
# runs and detects phishing without any of them set, just with reduced
# signal (no Safe Browsing cross-check, open CORS for local testing).

# Flask session secret. Render generates this automatically in production
# (see render.yaml) - only needed for local dev.
SECRET_KEY=dev-secret-change-me

# Free Google Safe Browsing v4 API key (https://developers.google.com/safe-browsing/v4/get-started).
# Without this, Safe Browsing checks are silently skipped.
SAFE_BROWSING_API_KEY=

# Comma-separated list of allowed CORS origins. Defaults to the extension
# scheme + production dashboard + local dev servers if unset - only need
# this if you're running the dashboard from a different origin.
ALLOWED_ORIGINS=

# SQLite DB file path. Defaults to backend/phishing_guard.db. In production
# on Render this is set to a path on the persistent disk (see render.yaml)
# so data survives redeploys.
DB_PATH=
